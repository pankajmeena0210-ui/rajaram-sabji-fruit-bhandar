<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Rajaram Sabji Fruit Bhandar</title>

<style>
*{box-sizing:border-box;margin:0;padding:0}
body{
  font-family:Arial,sans-serif;
  background:#f4f7f5;
  color:#17251c;
}
header{
  background:linear-gradient(135deg,#146b3a,#239653);
  color:white;
  padding:22px 16px;
}
header h1{font-size:24px}
header p{margin-top:5px;opacity:.9}

.container{
  max-width:1100px;
  margin:auto;
  padding:16px;
}

.cards{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:12px;
  margin-bottom:20px;
}
.card{
  background:white;
  padding:18px;
  border-radius:15px;
  box-shadow:0 3px 12px #00000012;
}
.card small{color:#68736c}
.card h2{margin-top:8px;font-size:22px}
.green{color:#149447}
.red{color:#d93636}
.blue{color:#1769aa}

nav{
  display:flex;
  gap:8px;
  overflow:auto;
  margin-bottom:18px;
}
nav button{
  border:0;
  padding:11px 16px;
  border-radius:10px;
  background:white;
  cursor:pointer;
  font-weight:bold;
  white-space:nowrap;
}
nav button.active{
  background:#168747;
  color:white;
}

.section{
  display:none;
}
.section.active{display:block}

.box{
  background:white;
  padding:18px;
  border-radius:15px;
  margin-bottom:18px;
  box-shadow:0 3px 12px #00000010;
}
.box h2{margin-bottom:15px}

.form{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:10px;
}
input,select{
  width:100%;
  padding:12px;
  border:1px solid #d6ddd8;
  border-radius:9px;
  font-size:15px;
}
button.primary{
  background:#168747;
  color:white;
  border:0;
  padding:12px;
  border-radius:9px;
  font-weight:bold;
  cursor:pointer;
}
button.delete{
  background:#ffe7e7;
  color:#c62828;
  border:0;
  padding:7px 10px;
  border-radius:7px;
  cursor:pointer;
}

table{
  width:100%;
  border-collapse:collapse;
}
th,td{
  padding:11px 8px;
  border-bottom:1px solid #edf0ee;
  text-align:left;
}
th{background:#f5f8f6}

.empty{
  text-align:center;
  padding:25px;
  color:#777;
}

.balance{
  font-size:30px;
  font-weight:bold;
}

@media(max-width:750px){
  .cards{grid-template-columns:repeat(2,1fr)}
  .form{grid-template-columns:1fr 1fr}
  table{font-size:13px}
  th,td{padding:8px 5px}
}
@media(max-width:450px){
  .form{grid-template-columns:1fr}
  .cards{grid-template-columns:1fr 1fr}
}
</style>
</head>

<body>

<header>
  <div class="container">
    <h1>🥬 Rajaram Sabji Fruit Bhandar</h1>
    <p>Vegetables & Fresh Fruits Management</p>
  </div>
</header>

<div class="container">

<!-- DASHBOARD -->
<section id="dashboard" class="section active">

  <div class="cards">
    <div class="card">
      <small>Today's Income</small>
      <h2 class="green" id="income">₹0</h2>
    </div>

    <div class="card">
      <small>Today's Expense</small>
      <h2 class="red" id="expense">₹0</h2>
    </div>

    <div class="card">
      <small>Net Profit / Loss</small>
      <h2 id="profit">₹0</h2>
    </div>

    <div class="card">
      <small>Total Stock Items</small>
      <h2 class="blue" id="stockCount">0</h2>
    </div>
  </div>

  <div class="box">
    <h2>💰 Current Balance</h2>
    <div class="balance" id="balance">₹0</div>
    <p style="margin-top:8px;color:#777">
      Income − Expenses
    </p>
  </div>

  <div class="box">
    <h2>📊 Recent Transactions</h2>
    <div id="recent"></div>
  </div>

</section>

<!-- STOCK -->
<section id="stock" class="section">

  <div class="box">
    <h2>📦 Add Product / Stock</h2>

    <div class="form">
      <input id="productName" placeholder="Product name">
      <input id="productQty" type="number" placeholder="Quantity">
      <input id="buyRate" type="number" placeholder="Buy rate ₹">
      <input id="sellRate" type="number" placeholder="Sell rate ₹">
      <select id="unit">
        <option value="kg">Kg</option>
        <option value="dozen">Dozen</option>
        <option value="piece">Piece</option>
        <option value="crate">Crate</option>
      </select>
      <button class="primary" onclick="addProduct()">Add Stock</button>
    </div>
  </div>

  <div class="box">
    <h2>🥕 Current Stock</h2>
    <div id="stockTable"></div>
  </div>

</section>

<!-- SALES -->
<section id="sales" class="section">

  <div class="box">
    <h2>🛒 Add Sale / Income</h2>

    <div class="form">
      <input id="saleProduct" placeholder="Product name">
      <input id="saleQty" type="number" placeholder="Quantity sold">
      <input id="saleRate" type="number" placeholder="Rate ₹">
      <button class="primary" onclick="addSale()">Add Sale</button>
    </div>
  </div>

  <div class="box">
    <h2>💵 Sales History</h2>
    <div id="salesTable"></div>
  </div>

</section>

<!-- EXPENSE -->
<section id="expenses" class="section">

  <div class="box">
    <h2>💸 Add Expense</h2>

    <div class="form">
      <input id="expenseName" placeholder="Expense name">
      <input id="expenseAmount" type="number" placeholder="Amount ₹">
      <button class="primary" onclick="addExpense()">Add Expense</button>
    </div>
  </div>

  <div class="box">
    <h2>🔴 Expense History</h2>
    <div id="expenseTable"></div>
  </div>

</section>

<!-- REPORT -->
<section id="reports" class="section">

  <div class="box">
    <h2>📈 Business Report</h2>

    <div class="cards">
      <div class="card">
        <small>Total Income</small>
        <h2 class="green" id="totalIncome">₹0</h2>
      </div>

      <div class="card">
        <small>Total Expense</small>
        <h2 class="red" id="totalExpense">₹0</h2>
      </div>

      <div class="card">
        <small>Net Result</small>
        <h2 id="totalProfit">₹0</h2>
      </div>

      <div class="card">
        <small>Transactions</small>
        <h2 id="transactionCount">0</h2>
      </div>
    </div>

  </div>

</section>

<!-- NAVIGATION -->
<nav>
  <button class="active" onclick="showSection('dashboard',this)">🏠 Dashboard</button>
  <button onclick="showSection('stock',this)">📦 Stock</button>
  <button onclick="showSection('sales',this)">🛒 Sales</button>
  <button onclick="showSection('expenses',this)">💸 Expenses</button>
  <button onclick="showSection('reports',this)">📊 Reports</button>
</nav>

</div>

<script>

let products = JSON.parse(localStorage.getItem("products")) || [];
let sales = JSON.parse(localStorage.getItem("sales")) || [];
let expenses = JSON.parse(localStorage.getItem("expenses")) || [];

function save(){
  localStorage.setItem("products",JSON.stringify(products));
  localStorage.setItem("sales",JSON.stringify(sales));
  localStorage.setItem("expenses",JSON.stringify(expenses));
}

function money(n){
  return "₹" + Number(n).toLocaleString("en-IN");
}

function today(){
  return new Date().toLocaleDateString("en-IN");
}

function showSection(id,btn){

  document.querySelectorAll(".section").forEach(x=>{
    x.classList.remove("active");
  });

  document.getElementById(id).classList.add("active");

  document.querySelectorAll("nav button").forEach(x=>{
    x.classList.remove("active");
  });

  btn.classList.add("active");
}

function addProduct(){

  let name=document.getElementById("productName").value.trim();
  let qty=Number(document.getElementById("productQty").value);
  let buy=Number(document.getElementById("buyRate").value);
  let sell=Number(document.getElementById("sellRate").value);
  let unit=document.getElementById("unit").value;

  if(!name || qty<=0 || sell<=0){
    alert("Please enter valid product details.");
    return;
  }

  products.push({
    id:Date.now(),
    name,
    qty,
    buy,
    sell,
    unit,
    date:today()
  });

  save();

  document.getElementById("productName").value="";
  document.getElementById("productQty").value="";
  document.getElementById("buyRate").value="";
  document.getElementById("sellRate").value="";

  render();
}

function addSale(){

  let name=document.getElementById("saleProduct").value.trim();
  let qty=Number(document.getElementById("saleQty").value);
  let rate=Number(document.getElementById("saleRate").value);

  if(!name || qty<=0 || rate<=0){
    alert("Please enter valid sale details.");
    return;
  }

  let product=products.find(
    p=>p.name.toLowerCase()===name.toLowerCase()
  );

  if(product){

    if(product.qty<qty){
      alert("Not enough stock available!");
      return;
    }

    product.qty-=qty;
  }

  sales.push({
    id:Date.now(),
    name,
    qty,
    rate,
    amount:qty*rate,
    date:today()
  });

  save();

  document.getElementById("saleProduct").value="";
  document.getElementById("saleQty").value="";
  document.getElementById("saleRate").value="";

  render();
}

function addExpense(){

  let name=document.getElementById("expenseName").value.trim();
  let amount=Number(document.getElementById("expenseAmount").value);

  if(!name || amount<=0){
    alert("Please enter valid expense details.");
    return;
  }

  expenses.push({
    id:Date.now(),
    name,
    amount,
    date:today()
  });

  save();

  document.getElementById("expenseName").value="";
  document.getElementById("expenseAmount").value="";

  render();
}

function deleteProduct(id){
  if(confirm("Delete this product?")){
    products=products.filter(x=>x.id!==id);
    save();
    render();
  }
}

function deleteSale(id){
  if(confirm("Delete this sale?")){
    sales=sales.filter(x=>x.id!==id);
    save();
    render();
  }
}

function deleteExpense(id){
  if(confirm("Delete this expense?")){
    expenses=expenses.filter(x=>x.id!==id);
    save();
    render();
  }
}

function renderStock(){

  let box=document.getElementById("stockTable");

  if(products.length===0){
    box.innerHTML='<div class="empty">No stock added yet.</div>';
    return;
  }

  let html=`
  <table>
  <tr>
    <th>Product</th>
    <th>Qty</th>
    <th>Buy</th>
    <th>Sell</th>
    <th>Stock Value</th>
    <th></th>
  </tr>`;

  products.forEach(p=>{

    html+=`
    <tr>
      <td>${p.name}</td>
      <td>${p.qty} ${p.unit}</td>
      <td>${money(p.buy)}</td>
      <td>${money(p.sell)}</td>
      <td>${money(p.qty*p.buy)}</td>
      <td>
        <button class="delete" onclick="deleteProduct(${p.id})">
        Delete
        </button>
      </td>
    </tr>`;
  });

  html+="</table>";

  box.innerHTML=html;
}

function renderSales(){

  let box=document.getElementById("salesTable");

  if(sales.length===0){
    box.innerHTML='<div class="empty">No sales yet.</div>';
    return;
  }

  let html=`
  <table>
  <tr>
    <th>Date</th>
    <th>Product</th>
    <th>Qty</th>
    <th>Rate</th>
    <th>Income</th>
    <th></th>
  </tr>`;

  sales.slice().reverse().forEach(s=>{

    html+=`
    <tr>
      <td>${s.date}</td>
      <td>${s.name}</td>
      <td>${s.qty}</td>
      <td>${money(s.rate)}</td>
      <td class="green">+${money(s.amount)}</td>
      <td>
        <button class="delete" onclick="deleteSale(${s.id})">
        Delete
        </button>
      </td>
    </tr>`;
  });

  html+="</table>";

  box.innerHTML=html;
}

function renderExpenses(){

  let box=document.getElementById("expenseTable");

  if(expenses.length===0){
    box.innerHTML='<div class="empty">No expenses yet.</div>';
    return;
  }

  let html=`
  <table>
  <tr>
    <th>Date</th>
    <th>Expense</th>
    <th>Amount</th>
    <th></th>
  </tr>`;

  expenses.slice().reverse().forEach(e=>{

    html+=`
    <tr>
      <td>${e.date}</td>
      <td>${e.name}</td>
      <td class="red">-${money(e.amount)}</td>
      <td>
        <button class="delete" onclick="deleteExpense(${e.id})">
        Delete
        </button>
      </td>
    </tr>`;
  });

  html+="</table>";

  box.innerHTML=html;
}

function renderDashboard(){

  let income=sales.reduce((a,b)=>a+b.amount,0);
  let expense=expenses.reduce((a,b)=>a+b.amount,0);
  let profit=income-expense;

  document.getElementById("income").innerText=money(income);
  document.getElementById("expense").innerText=money(expense);

  let profitBox=document.getElementById("profit");
  profitBox.innerText=(profit>=0?"+":"-")+money(Math.abs(profit));
  profitBox.className=profit>=0?"green":"red";

  document.getElementById("balance").innerText=
    (profit>=0?"+":"-")+money(Math.abs(profit));

  document.getElementById("balance").className=
    "balance "+(profit>=0?"green":"red");

  document.getElementById("stockCount").innerText=products.length;

  document.getElementById("totalIncome").innerText=money(income);
  document.getElementById("totalExpense").innerText=money(expense);

  let totalProfit=document.getElementById("totalProfit");
  totalProfit.innerText=(profit>=0?"+":"-")+money(Math.abs(profit));
  totalProfit.className=profit>=0?"green":"red";

  document.getElementById("transactionCount").innerText=
    sales.length+expenses.length;

  let recent=document.getElementById("recent");

  let transactions=[];

  sales.forEach(s=>{
    transactions.push({
      date:s.date,
      name:s.name,
      amount:s.amount,
      type:"income"
    });
  });

  expenses.forEach(e=>{
    transactions.push({
      date:e.date,
      name:e.name,
      amount:e.amount,
      type:"expense"
    });
  });

  transactions=transactions.slice(-8).reverse();

  if(transactions.length===0){
    recent.innerHTML='<div class="empty">No transactions yet.</div>';
    return;
  }

  let html="<table><tr><th>Date</th><th>Details</th><th>Amount</th></tr>";

  transactions.forEach(t=>{
    html+=`
    <tr>
      <td>${t.date}</td>
      <td>${t.name}</td>
      <td class="${t.type==="income"?"green":"red"}">
        ${t.type==="income"?"+":"-"}${money(t.amount)}
      </td>
    </tr>`;
  });

  html+="</table>";

  recent.innerHTML=html;
}

function render(){

  renderStock();
  renderSales();
  renderExpenses();
  renderDashboard();

}

render();

</script>

</body>
</html>
